        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A7344B"
      }
    },
    {
      "name": "Comment (italic)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F6A85",
        "fontStyle": "italic"
      }
