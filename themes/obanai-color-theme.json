    "parameter": {
      "foreground": "#BFC4CC",
      "fontStyle": "italic"
    },
    "variable": "#E4E6EA",
    "variable.readonly": "#7FB8D9",
    "variable.defaultLibrary": "#7FB8D9",
    "property": "#A8D9D0",
    "property.readonly": "#7FB8D9",
    "enumMember": "#7FB8D9",
    "function": "#E8C05A",
