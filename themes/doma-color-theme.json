  "semanticTokenColors": {
    "namespace": "#D9A8E8",
    "class": "#D9A8E8",
    "enum": "#D9A8E8",
    "interface": "#D9A8E8",
    "struct": "#D9A8E8",
    "typeParameter": "#D9A8E8",
    "type": "#D9A8E8",
    "parameter": {
      "foreground": "#BCCFD2",
      "fontStyle": "italic"
    },
    "variable": "#DEECEE",
    "variable.readonly": "#A8C4F0",
    "variable.defaultLibrary": "#A8C4F0",
    "property": "#B8E0DE",
    "property.readonly": "#A8C4F0",
    "enumMember": "#A8C4F0",
    "function": "#E8D98F",
    "function.defaultLibrary": "#E8D98F",
    "method": "#E8D98F",
    "macro": "#D9A8E8",
    "decorator": "#D9A8E8",
