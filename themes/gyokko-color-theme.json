  "semanticTokenColors": {
    "namespace": "#8FD9A8",
    "class": "#8FD9A8",
    "enum": "#8FD9A8",
    "interface": "#8FD9A8",
    "struct": "#8FD9A8",
    "typeParameter": "#8FD9A8",
    "type": "#8FD9A8",
    "parameter": {
      "foreground": "#B8CFCE",
      "fontStyle": "italic"
    },
    "variable": "#DCEBEA",
    "variable.readonly": "#7FB8E0",
    "variable.defaultLibrary": "#7FB8E0",
    "property": "#A8D9D4",
    "property.readonly": "#7FB8E0",
    "enumMember": "#7FB8E0",
    "function": "#E8C46B",
