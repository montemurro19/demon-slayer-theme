  "semanticTokenColors": {
    "namespace": "#8FE0C4",
    "class": "#8FE0C4",
    "enum": "#8FE0C4",
    "interface": "#8FE0C4",
    "struct": "#8FE0C4",
    "typeParameter": "#8FE0C4",
    "type": "#8FE0C4",
    "parameter": {
      "foreground": "#D9C2CE",
      "fontStyle": "italic"
    },
    "variable": "#F7E6EE",
    "variable.readonly": "#C7A8F0",
    "variable.defaultLibrary": "#C7A8F0",
    "property": "#EFC4D6",
    "property.readonly": "#C7A8F0",
    "enumMember": "#C7A8F0",
    "function": "#F5D07E",
