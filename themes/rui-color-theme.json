  "semanticTokenColors": {
    "namespace": "#C4A8D9",
    "class": "#C4A8D9",
    "enum": "#C4A8D9",
    "interface": "#C4A8D9",
    "struct": "#C4A8D9",
    "typeParameter": "#C4A8D9",
    "type": "#C4A8D9",
    "parameter": {
      "foreground": "#BEC7C0",
      "fontStyle": "italic"
    },
    "variable": "#DEE4DE",
    "variable.readonly": "#8FA8C4",
    "variable.defaultLibrary": "#8FA8C4",
    "property": "#C4CFC4",
    "property.readonly": "#8FA8C4",
    "enumMember": "#8FA8C4",
    "function": "#E0BFA8",
    "function.defaultLibrary": "#E0BFA8",
    "method": "#E0BFA8",
    "macro": "#C4A8D9",
    "decorator": "#C4A8D9",
    "label": "#E5626B",
    "keyword": "#E5626B",
    "string": "#A8C4A0",
    "number": "#8FA8C4",
    "regexp": "#9FC4BC",
    "operator": "#9CA8A0",
    "comment.documentation": {
      "foreground": "#818E86",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#818E86"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#E5626B"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#E5626B"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9CA8A0"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#A8C4A0"
      }
    },
    {
      "name": "String escape / interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E0BFA8"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#9FC4BC"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#8FA8C4"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8FA8C4"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E0BFA8"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "source"
      ],
      "settings": {
        "foreground": "#DEE4DE"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#BEC7C0"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C4CFC4"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#C4A8D9"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "support.type",
        "entity.name.namespace",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#C4A8D9"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#C4A8D9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8B978F"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#E5626B"
      }
    },
    {
      "name": "Attribute / selector",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#E0BFA8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E5525C"
      }
    },
    {
      "name": "Comment (italic)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#818E86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter (italic)",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#BEC7C0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "entity.name.function.deprecated",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E5525C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E5626B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#8FA8C4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8FA8C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E0BFA8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown list / quote",
      "scope": [
        "markup.list punctuation.definition.list",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8B978F"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A8C4A0"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
