  "semanticTokenColors": {
    "namespace": "#9FD9D0",
    "class": "#9FD9D0",
    "enum": "#9FD9D0",
    "interface": "#9FD9D0",
    "struct": "#9FD9D0",
    "typeParameter": "#9FD9D0",
