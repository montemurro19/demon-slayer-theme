  "semanticTokenColors": {
    "namespace": "#C264D9",
    "class": "#C264D9",
    "enum": "#C264D9",
    "interface": "#C264D9",
    "struct": "#C264D9",
    "typeParameter": "#C264D9",
    "type": "#C264D9",
    "parameter": {
      "foreground": "#C9BAC0",
      "fontStyle": "italic"
    },
    "variable": "#E8DEE2",
    "variable.readonly": "#8FA0C4",
    "variable.defaultLibrary": "#8FA0C4",
    "property": "#C9B4C0",
    "property.readonly": "#8FA0C4",
    "enumMember": "#8FA0C4",
    "function": "#E58FA0",
    "function.defaultLibrary": "#E58FA0",
    "method": "#E58FA0",
    "macro": "#D98FB8",
    "decorator": "#D98FB8",
    "label": "#E0455C",
    "keyword": "#E0455C",
    "string": "#B08FD9",
    "number": "#8FA0C4",
    "regexp": "#D98FB8",
    "operator": "#AC9BA3",
    "comment.documentation": {
      "foreground": "#8F7D85",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8F7D85"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#E0455C"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#E0455C"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#AC9BA3"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#B08FD9"
      }
    },
    {
      "name": "String escape / interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E8B06B"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D98FB8"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#8FA0C4"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8FA0C4"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E58FA0"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "source"
      ],
      "settings": {
        "foreground": "#E8DEE2"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#C9BAC0"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C9B4C0"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#C264D9"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "support.type",
        "entity.name.namespace",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#C264D9"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#D98FB8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#988791"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#E0455C"
      }
    },
    {
      "name": "Attribute / selector",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#E58FA0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F0505C"
      }
    },
    {
      "name": "Comment (italic)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F7D85",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter (italic)",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#C9BAC0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "entity.name.function.deprecated",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F0505C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E0455C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#8FA0C4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8FA0C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#C264D9",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown list / quote",
      "scope": [
        "markup.list punctuation.definition.list",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#988791"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#B08FD9"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
