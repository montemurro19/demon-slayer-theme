    "parameter": {
      "foreground": "#CBC2CF",
      "fontStyle": "italic"
    },
    "variable": "#F0EAF0",
    "variable.readonly": "#8FD9E8",
    "variable.defaultLibrary": "#8FD9E8",
    "property": "#E8D4A8",
    "property.readonly": "#8FD9E8",
    "enumMember": "#8FD9E8",
    "function": "#E85D9E",
