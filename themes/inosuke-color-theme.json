        "meta.annotation"
      ],
      "settings": {
        "foreground": "#E8A85C"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.separator",
